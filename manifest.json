{
  "manifest_version": 3,
  "name": "TriggerBlock",
  "version": "1.2.1",

  "description": "Filters sensitive content for many different phobias. ",

  "icons": {
    "32": "icons/TriggerBlockLogo32.svg",
    "48": "icons/TriggerBlockLogo.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "triggerblock@aleksamilosevic07.github.io",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": ["storage"],

  "action": {
    "default_icon": {
      "32": "icons/TriggerBlockLogo32.svg"
    },
    "default_title": "TriggerBlock",
    "default_popup": "triggermenu/menu.html"
  },

  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["triggerblock.js"],
      "css": ["triggerblock.css"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["fears.json"],
      "matches": ["*://*/*"]
    }
  ]
}